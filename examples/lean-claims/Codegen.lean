import Model

/-!
# PyTorch code generation

`lake exe codegen` writes `generated_model.py`: one PyTorch module per variant of
`Model.variants`, plus the attention probe. Each `Model.Op` becomes exactly one
PyTorch expression (`pythonOf`), so checking the generator means checking each
operation's line once; `train_ablation.py` imports the result and does not define
a model of its own.
-/

namespace Codegen

open Model

def v (i : Nat) : String := s!"v{i}"

def lastDim (shapes : Array (Option Shape)) (i : Nat) : String :=
  match (shapeAt shapes i).bind List.getLast? with
  | some (.n d) => toString d
  | _ => "None"

def pythonOf (shapes : Array (Option Shape)) : Op → String
  | .srcTokens => "src"
  | .tgtTokens => "tgt"
  | .targets => "targets"
  | .memory _ => "memory"
  | .input _ _ => "x"
  | .param name _ _ => s!"self.params[\"{name}\"]"
  | .embed t ids => s!"F.embedding({v ids}, {v t}, padding_idx=PAD)"
  | .scaleSqrt k x => s!"{v x} * math.sqrt({k})"
  | .addPositions x => s!"{v x} + positions({v x})"
  | .dropout x => s!"F.dropout({v x}, p=self.p_drop, training=self.training)"
  | .linear w x => s!"F.linear({v x}, {v w})"
  | .linearBias w b x => s!"F.linear({v x}, {v w}, {v b})"
  | .add x y => s!"{v x} + {v y}"
  | .relu x => s!"F.relu({v x})"
  | .layerNorm g b x => s!"F.layer_norm({v x}, ({lastDim shapes x},), {v g}, {v b})"
  | .splitHeads h x => s!"split_heads({v x}, {h})"
  | .mergeHeads x => s!"merge_heads({v x})"
  | .scores q k => s!"{v q} @ {v k}.transpose(-2, -1)"
  | .scaleInvSqrt k x => s!"{v x} / math.sqrt({k})"
  | .maskFuture x => s!"{v x}.masked_fill(future_positions({v x}), NEG_INF)"
  | .maskPadKeys ids x => s!"{v x}.masked_fill(pad_keys({v ids}), NEG_INF)"
  | .softmax x => s!"torch.softmax({v x}, dim=-1)"
  | .weighted p val => s!"{v p} @ {v val}"
  | .tiedLogits x t => s!"{v x} @ {v t}.T"
  | .crossEntropy lg t num den => s!"smoothed_cross_entropy({v lg}, {v t}, {num} / {den})"

def initOf (name : String) (shape : List Nat) : Init → String
  | .embedding => s!"nn.init.normal_(self.params[\"{name}\"], std={shape.getLastD 1}**-0.5)"
  | .linearWeight => s!"init_uniform(self.params[\"{name}\"], {shape.getLastD 1})"
  | .linearBias fanIn => s!"init_uniform(self.params[\"{name}\"], {fanIn})"
  | .ones => s!"nn.init.ones_(self.params[\"{name}\"])"
  | .zeros => s!"nn.init.zeros_(self.params[\"{name}\"])"

def body (b : Built) : List String :=
  let sh := shapes b.prog
  let lines := (b.prog.toList.zip (List.range b.prog.size)).map fun (op, i) =>
    s!"        {v i} = {pythonOf sh op}"
  lines ++ [s!"        return {v b.out}"]

def paramInits (progs : List Program) : List (String × List Nat × Init) :=
  progs.foldl (fun acc p => p.foldl (fun acc op => match op with
    | .param name s init => if acc.any (·.1 == name) then acc else acc ++ [(name, s, init)]
    | _ => acc) acc) []

def configSource (c : Config) : List String :=
  ["    config = {",
   s!"        \"N\": {c.N},",
   s!"        \"d_model\": {c.dModel},",
   s!"        \"d_ff\": {c.dFF},",
   s!"        \"h\": {c.h},",
   s!"        \"d_k\": {c.dk},",
   s!"        \"d_v\": {c.dv},",
   s!"        \"p_drop\": {c.pDrop},",
   s!"        \"eps_ls\": {c.epsNum} / {c.epsDen},",
   s!"        \"vocab_size\": {c.vocab},",
   "    }",
   ""]

def moduleSource (cls : String) (cfg : Option Config) (pDrop : String)
    (methods : List (String × String × Built)) : String :=
  let progs := methods.map (·.2.2.prog)
  let ps := paramInits progs
  let decls := ps.map fun (name, s, _) =>
    s!"                \"{name}\": nn.Parameter(torch.empty({", ".intercalate (s.map toString)})),"
  let inits := ps.map fun (name, s, init) => s!"            {initOf name s init}"
  let header := [
    s!"class {cls}(nn.Module):"] ++ (cfg.map configSource).getD [] ++ [
    "    def __init__(self):",
    "        super().__init__()",
    s!"        self.p_drop = {pDrop}",
    "        self.params = nn.ParameterDict(",
    "            {"] ++ decls ++ [
    "            }",
    "        )",
    "        with torch.no_grad():"] ++ inits
  let ms := methods.map fun (name, args, b) =>
    [""] ++ [s!"    def {name}(self, {args}):"] ++ body b
  "\n".intercalate (header ++ ms.flatten) ++ "\n"

def preamble : String := "\"\"\"Generated by `lake exe codegen` from Model.lean. Do not edit by hand.\"\"\"

import math

import torch
import torch.nn.functional as F
from torch import nn

PAD = 0


NEG_INF = float(\"-inf\")


def init_uniform(p, fan_in):
    nn.init.uniform_(p, -(fan_in**-0.5), fan_in**-0.5)


def positions(x):
    length, d = x.shape[1], x.shape[-1]
    pos = torch.arange(length, device=x.device).unsqueeze(1)
    freqs = torch.exp(torch.arange(0, d, 2, device=x.device) * (-math.log(10000.0) / d))
    pe = torch.zeros(length, d, device=x.device)
    pe[:, 0::2] = torch.sin(pos * freqs)
    pe[:, 1::2] = torch.cos(pos * freqs)
    return pe


def split_heads(x, h):
    return x.view(x.shape[0], x.shape[1], h, -1).transpose(1, 2)


def merge_heads(x):
    return x.transpose(1, 2).reshape(x.shape[0], x.shape[2], -1)


def future_positions(scores):
    n = scores.shape[-1]
    allowed = torch.ones(n, n, dtype=torch.bool, device=scores.device).tril()
    return ~allowed


def pad_keys(ids):
    return (ids == PAD)[:, None, None, :]


def smoothed_cross_entropy(logits, targets, eps):
    return F.cross_entropy(
        logits.reshape(-1, logits.shape[-1]),
        targets.reshape(-1),
        ignore_index=PAD,
        label_smoothing=eps,
    )
"

def className (name : String) : String := s!"Transformer_{name}"

def rstrip (s : String) : String := String.ofList (s.toList.reverse.dropWhile Char.isWhitespace).reverse

def source : String :=
  let models := variants.map fun (name, c) =>
    moduleSource (className name) (some c) c.pDrop
      [("encode", "src", build (encoder c)),
       ("decode", "tgt, memory, src", build (decoder c)),
       ("loss", "x, targets", build (loss c))]
  let probeSrc := moduleSource "ProbeAttention" none "0.0"
    [("unmasked", "x", probe .none), ("masked", "x", probe .future)]
  let registry := "MODELS = {\n" ++ String.join (variants.map fun (name, _) =>
    s!"    \"{name}\": {className name},\n") ++ "}\n"
  "\n\n\n".intercalate ([rstrip preamble] ++ models.map rstrip ++ [rstrip probeSrc, rstrip registry]) ++ "\n"

end Codegen

def main : IO Unit := do
  IO.FS.writeFile "generated_model.py" Codegen.source
  IO.println "Wrote generated_model.py"
